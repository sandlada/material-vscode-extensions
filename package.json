{
  "private": true,
  "name": "material-vscode-extension-monorepo",
  "version": "0.0.0",
  "description": "Monorepo for the Material Web Snippets and Material Design CSS Snippets VS Code extensions.",
  "repository": {
    "type": "git",
    "url": "https://github.com/sandlada/material-vscode-extensions"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "compile": "npm run compile -w packages/material-web-snippets",
    "watch": "npm run watch -w packages/material-web-snippets",
    "generate": "tsc -p tsconfig.tools.json && node tools-dist/scripts/generate.js --write",
    "generate:check": "tsc -p tsconfig.tools.json && node tools-dist/scripts/generate.js --check",
    "generate:stdout": "tsc -p tsconfig.tools.json && node tools-dist/scripts/generate.js --stdout",
    "verify": "tsc -p tsconfig.tools.json && node tools-dist/scripts/verify.js"
  },
  "devDependencies": {
    "@material/web": "^2.5.0",
    "@types/node": "^26.5.1",
    "@types/vscode": "^1.137.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2"
  }
}

{
  "name": "material-web-vscode-snippets",
  "displayName": "Material Web Components Snippets",
  "description": "A material design 3(@material/web) snippets extension of visual studio code.",
  "keywords": [
    "google",
    "material",
    "snippets",
    "material web components"
  ],
  "author": "kai-orion",
  "publisher": "kai-orion",
  "license": "MIT",
  "version": "0.0.5",
  "icon": "src/images/icon/extension-icon-128.png",
  "engines": {
    "vscode": "^1.82.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kai-orion/material-web-vscode-snippets"
  },
  "categories": [
    "Snippets"
  ],
  "contributes": {
    "snippets": [
      {
        "language": "html",
        "path": "./snippets/snippets.code-snippets"
      },
      {
        "language": "css",
        "path": "./snippets/css.code-snippets"
      }
    ],
    "html": {
      "customData": [
        "./custom-data/html.html-data.json"
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "title": "Material Web Components",
          "id": "material-web-components-snippets",
          "icon": "src/images/icon/extension-icon-32-outlined.svg"
        }
      ]
    },
    "views": {
      "material-web-components-snippets": [
        {
          "id": "tree",
          "name": "Code Snippets",
          "type": "tree"
        }
      ]
    }
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "generate": "tsc -p tsconfig.tools.json && node tools-dist/scripts/generate.js --write",
    "generate:check": "tsc -p tsconfig.tools.json && node tools-dist/scripts/generate.js --check",
    "generate:stdout": "tsc -p tsconfig.tools.json && node tools-dist/scripts/generate.js --stdout",
    "verify": "tsc -p tsconfig.tools.json && node tools-dist/scripts/verify.js",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@material/web": "^2.5.0",
    "@types/node": "^26.5.1",
    "@types/vscode": "^1.137.0",
    "typescript": "^7.0.2"
  }
}

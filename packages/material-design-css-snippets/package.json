{
    "author": "Kai Orion & Sandlada",
    "bugs": {
        "url": "https://github.com/sandlada/material-vscode-extensions/issues"
    },
    "categories": [
        "Snippets"
    ],
    "contributes": {
        "snippets": [
            {
                "language": "css",
                "path": "./snippets/css.code-snippets"
            }
        ]
    },
    "description": "Material Design 3 CSS design token snippets (color, palette, typescale, shape, motion, space) for Visual Studio Code.",
    "devDependencies": {
        "@types/node": "^26.5.1",
        "@vscode/vsce": "^4.0.0",
        "material-snippets-tools": "*",
        "typescript": "^7.0.2"
    },
    "displayName": "Material Design CSS Snippets",
    "engines": {
        "vscode": "^1.137.0"
    },
    "galleryBanner": {
        "color": "#6750A4",
        "theme": "dark"
    },
    "homepage": "https://github.com/sandlada/material-vscode-extensions/tree/main/packages/material-design-css-snippets",
    "icon": "images/icon/extension-icon-128.png",
    "keywords": [
        "material",
        "material-design",
        "material-you",
        "css",
        "design-tokens",
        "snippets"
    ],
    "license": "MIT",
    "name": "material-design-css-snippets",
    "publisher": "sandlada",
    "repository": {
        "directory": "packages/material-design-css-snippets",
        "type": "git",
        "url": "https://github.com/sandlada/material-vscode-extensions"
    },
    "scripts": {
        "build:tools": "tsc -p tsconfig.tools.json",
        "generate": "npm run build:tools && node tools-dist/scripts/generate.js --write",
        "generate:check": "npm run build:tools && node tools-dist/scripts/generate.js --check",
        "generate:stdout": "npm run build:tools && node tools-dist/scripts/generate.js --stdout",
        "package": "vsce package --no-dependencies",
        "verify": "npm run build:tools && node tools-dist/scripts/verify.js"
    },
    "version": "0.0.2"
}

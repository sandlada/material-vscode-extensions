{
    "author": "Kai Orion & Sandlada",
    "bugs": {
        "url": "https://github.com/sandlada/material-vscode-extensions/issues"
    },
    "categories": [
        "Snippets"
    ],
    "contributes": {
        "html": {
            "customData": [
                "./custom-data/html.html-data.json"
            ]
        },
        "snippets": [
            {
                "language": "html",
                "path": "./snippets/snippets.code-snippets"
            },
            {
                "language": "javascriptreact",
                "path": "./snippets/snippets.code-snippets"
            },
            {
                "language": "typescriptreact",
                "path": "./snippets/snippets.code-snippets"
            }
        ]
    },
    "description": "Snippets for Material Design 3 (@material/web) Web Components in Visual Studio Code.",
    "devDependencies": {
        "@material/web": "^2.5.0",
        "@types/node": "^26.5.1",
        "@vscode/vsce": "^4.0.0",
        "material-snippets-tools": "*",
        "typescript": "^7.0.2"
    },
    "displayName": "Material Web HTML Snippets",
    "engines": {
        "vscode": "^1.137.0"
    },
    "galleryBanner": {
        "color": "#6750A4",
        "theme": "dark"
    },
    "homepage": "https://github.com/sandlada/material-vscode-extensions/tree/main/packages/material-web-snippets",
    "icon": "images/icon/extension-icon-128.png",
    "keywords": [
        "material",
        "material-design",
        "material-you",
        "material web",
        "material web components",
        "web-components",
        "snippets",
        "html"
    ],
    "license": "MIT",
    "name": "material-web-snippets",
    "publisher": "sandlada",
    "repository": {
        "directory": "packages/material-web-snippets",
        "type": "git",
        "url": "https://github.com/sandlada/material-vscode-extensions"
    },
    "scripts": {
        "build:tools": "tsc -p tsconfig.tools.json",
        "generate": "npm run build:tools && node tools-dist/scripts/generate.js --write",
        "generate:check": "npm run build:tools && node tools-dist/scripts/generate.js --check",
        "generate:stdout": "npm run build:tools && node tools-dist/scripts/generate.js --stdout",
        "package": "vsce package --no-dependencies",
        "verify": "npm run build:tools && node tools-dist/scripts/verify.js"
    },
    "version": "0.1.0"
}

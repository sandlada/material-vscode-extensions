{
    "author": "Kai Orion & Sandlada",
    "bugs": {
        "url": "https://github.com/sandlada/material-vscode-extensions/issues"
    },
    "categories": [
        "Snippets"
    ],
    "contributes": {
        "html": {
            "customData": [
                "./custom-data/html.html-data.json"
            ]
        },
        "snippets": [
            {
                "language": "html",
                "path": "./snippets/snippets.code-snippets"
            },
            {
                "language": "javascriptreact",
                "path": "./snippets/snippets.code-snippets"
            },
            {
                "language": "typescriptreact",
                "path": "./snippets/snippets.code-snippets"
            }
        ],
        "views": {
            "material-web-components-snippets": [
                {
                    "id": "tree",
                    "name": "Code Snippets",
                    "type": "tree"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "icon": "src/images/icon/extension-icon-32-outlined.svg",
                    "id": "material-web-components-snippets",
                    "title": "Material Web Components"
                }
            ]
        }
    },
    "description": "Snippets for Material Design 3 (@material/web) Web Components in Visual Studio Code.",
    "displayName": "Material Web Snippets",
    "engines": {
        "vscode": "^1.82.0"
    },
    "galleryBanner": {
        "color": "#6750A4",
        "theme": "dark"
    },
    "homepage": "https://github.com/sandlada/material-vscode-extensions/tree/main/packages/material-web-snippets",
    "icon": "src/images/icon/extension-icon-128.png",
    "keywords": [
        "material",
        "material-design",
        "material-you",
        "material web",
        "material web components",
        "web-components",
        "snippets",
        "html"
    ],
    "license": "MIT",
    "main": "./out/extension.js",
    "name": "material-web-snippets",
    "publisher": "sandlada",
    "repository": {
        "directory": "packages/material-web-snippets",
        "type": "git",
        "url": "https://github.com/sandlada/material-vscode-extensions"
    },
    "scripts": {
        "compile": "tsc -p ./",
        "package": "vsce package --no-dependencies",
        "vscode:prepublish": "npm run compile",
        "watch": "tsc -watch -p ./"
    },
    "version": "1.0.0"
}

{
    "compilerOptions": {
        "declaration": true,
        "esModuleInterop": true,
        "lib": ["ESNext", "dom"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "outDir": "dist",
        "rootDir": "src",
        "skipLibCheck": true,
        "sourceMap": false,
        "strict": true,
        "target": "ESNext",
        "types": ["node"]
    },
    "include": [
        "src"
    ]
}
